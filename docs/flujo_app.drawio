          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Fila B: traducir -->
        <mxCell id="lblB" value="&lt;b&gt;B · Traducir&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;traducir_pagina()&lt;br&gt;en un hilo,&lt;br&gt;sin parar la CPU&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4c1d95;" vertex="1" parent="fase2">
          <mxGeometry x="20" y="175" width="125" height="70" as="geometry" />
        </mxCell>
