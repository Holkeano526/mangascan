        <!-- Nota de solapamiento -->
        <mxCell id="nota" value="&lt;b&gt;Orden en el tiempo:&lt;/b&gt; detectar N → lanzar traducción N → renderizar N‑2 → detectar N+1…&lt;br&gt;La GPU y la CPU nunca procesan dos etapas de cálculo a la vez; las traducciones viajan mientras tanto.&lt;br&gt;Con la iGPU: ~5 s/página (antes 49 s). Leyenda: &lt;font color=&quot;#15803d&quot;&gt;■&lt;/font&gt; iGPU · &lt;font color=&quot;#1d4ed8&quot;&gt;■&lt;/font&gt; CPU · &lt;font color=&quot;#c2410c&quot;&gt;■&lt;/font&gt; red" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="fase2">
          <mxGeometry x="170" y="405" width="940" height="78" as="geometry" />
        </mxCell>
