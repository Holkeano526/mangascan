        <mxCell id="eBC" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=#ffffff;strokeColor=#c2410c;endArrow=block;dashed=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="fase2" source="valid" target="txt" value="traducción lista">
