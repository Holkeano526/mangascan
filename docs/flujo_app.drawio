        </mxCell>
        <mxCell id="subtitulo" value="PDF en japonés/coreano → PDF en español latino. Modelos locales (CPU + iGPU Intel) y DeepSeek solo para traducir." style="text;html=1;fontSize=13;fontColor=#475569;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="900" height="26" as="geometry" />
