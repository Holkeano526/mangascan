        <mxCell id="fase3" value="3 · Ensamblaje (una vez)" style="swimlane;startSize=28;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=13;rounded=1;" vertex="1" parent="1">
