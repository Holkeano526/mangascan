        <mxCell id="titulo" value="&lt;b&gt;MangaScan AI&lt;/b&gt; — flujo de una traducción" style="text;html=1;fontSize=22;fontColor=#1e1b4b;align=left;verticalAlign=middle;" vertex="1" parent="1">
