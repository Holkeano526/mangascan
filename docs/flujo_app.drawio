<mxfile host="drawio" agent="MangaScan docs" version="24.0.0">
  <diagram id="flujo-mangascan" name="Flujo de MangaScan AI">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="1330" background="#ffffff" math="0" shadow="0">
